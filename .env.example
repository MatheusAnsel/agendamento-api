# Copie para .env e ajuste. Nunca commite o .env.
ENV=development

# Aceita postgres:// e postgresql:// (convertido automaticamente para psycopg 3).
# Supabase: use a conexao direta ou o pooler em modo sessao, nao o modo transacao (porta 6543).
DATABASE_URL=postgresql+psycopg://agendamento:agendamento@localhost:5432/agendamento

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE_MINUTES=720
